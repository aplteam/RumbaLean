 Start←{
     _←'Conga'##.⎕CY'conga'   ⍝ Kai: dynamic loading of Conga
     _←⎕SE.Tatin.LoadPackages'https://tatin.dev/HandleError'#
     _←#.⎕SHADOW'ErrorParms'
     #.ErrorParms←#.HandleError.CreateParms
     _←1 ##.Core.InitConga''
     _←HandleRide
     s←##.Core.NewServer 0
     s.Port←8080 ⍝ Kai
     s.Secure←1  ⍝ Kai
     _←'Strings's.⎕NS''
     s.OnRequest←'OnRequest'
     s.OnHeader←'OnRequestHeader'
     s.CongaTimeout←1000                     ⍝ House keeping every second keeps TestHouseKeepingWhenBusy short
     s.OnCongaTimeout←'CountHouseKeeping'
     s.HouseKeepingCount←0
     s.Caching←1
     s.Folder←##.Tests.GetTestDir,'/RumbaTestServer'
     s.LogHTTP←1
     s.LogConga←1
     s.LogRumba←1
     s.LogHTTPToSession←1
     s.CertType←'DER'
     s.Context←⎕THIS
     _←s ##.Core.Start 0
     s
 }
