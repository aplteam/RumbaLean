 TestChunkedHeadRequest←{
     ⍺←0
     c←R.NewClient 0
     c.Port←8080    ⍝ Kai
     c.LogCongaEvents←⍺
     q←R.NewRequest'/ChunkedTest1'
     q.Method←'HEAD'
     _←c R.Send q
     r←c R.Receive 0

     q2←R.NewRequest'/ChunkedTest1'
     q2.Method←'GET'
     _←c R.Send q2
     r2←c R.Receive 0

     _←c R.Close 0
     r.Content≢'':1
     r2.Content≢'This is a chunked message':1
     RemoveDate←{
         ⍝ "Date" has a resolution of one second, so the HEAD and the GET may straddle
         ⍝ a boundary and differ with nothing actually being wrong; Kai
         ((⊂'date')≢¨0⊃¨⍵)/⍵                 ⍝ Names arrive in lower case, see ProcessHeader
     }
     (RemoveDate r.Headers)≢RemoveDate r2.Headers:1
     0
 }
