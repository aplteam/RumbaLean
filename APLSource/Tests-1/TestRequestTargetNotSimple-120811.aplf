 TestRequestTargetNotSimple←{
     ⍝ A "RequestTarget" that is nested or numeric must be refused with a DOMAIN ERROR,
     ⍝ and that must happen before a connection is opened
     c←R.NewClient 0
     c.Port←8080
     q←R.NewRequest 0
     q.RequestTarget←'/Hello' 'World'
     11≠c{11::11 ⋄ ⍺ R.Send ⍵}q:1
     q.RequestTarget←1 2 3
     11≠c{11::11 ⋄ ⍺ R.Send ⍵}q:1
     0≠c.State:1
     0
 }
