 r←HandleRequest m;c;s
 r←0
 :If m≠0
 :AndIf ~m.ResponseSent               ⍝ `HandleHeader` has answered already: OnHeader's response, a 500 or a 503
     c←m.Connection
     s←c.Server
     m.Tid←⎕TID
     r←ExecuteRequestHandler m
     r.Close←~IsPersistent m
     {}SendResponse r
     m.ResponseSent←1
     c.MessageLog,←⊂m.Method m.RequestTarget r.StatusCode
     {}s LogHTTPToSession r
     {}UpdateStats r
     {}Log r
     {}DisplayRequestResponse r
     :If r.Close
         ExpungeConnection c
     :Else
         c.Messages←1↓c.Messages
     :EndIf
 :EndIf
⍝Done
