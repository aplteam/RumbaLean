 WaitForData x;_;dmx;⎕TRAP
⍝ x ←→ Connection
⍝ ⎕TRAP must be localized for "C" (cut back) to work
 :If 0<⎕NC'#.ErrorParms.signal'
     ⎕TRAP←⊂#.ErrorParms.signal'C' '→∆CarryOn'
 :EndIf
 ⎕TNAME←'Rumba Wait For Data'
 x.Tid←⎕TID
 _←{
     tids←⎕TGET ⍵.Tid
     0=≢tids:∇ ⍵                        ⍝ in case there is no thread at all
     (e d)←⊃tids
     d≡1119:'1119'CloseConnection ⍵
     e≢'Block':e CloseConnection ⍵
     ⍵.LastReceiveTime←QTS
     ⍵.LastBlock←d                      ⍝ As received, for crash reports; see `GetConnectionOfThread`
     m←↑⌽⍵.Messages
     cm←d GatherRequestMessage m
     _←HandleRequest¨cm
     ∇ ⍵
 }x
 :Return

∆CarryOn:
 ErrorInRumba ⍬
⍝Done
